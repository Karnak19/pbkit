// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`generateZod snapshot 1`] = `
"// Generated by pbkit-zod — do not edit

import { z } from "zod"

export const BaseRecordSchema = z.object({
  id: z.string(),
  created: z.string(),
  updated: z.string(),
  collectionId: z.string(),
  collectionName: z.string(),
})

const AuthRecordFields = {
  email: z.string().email(),
  emailVisibility: z.boolean(),
  verified: z.boolean(),
}

export const AuthRecordSchema = BaseRecordSchema.extend(AuthRecordFields)

// --- Users ---

export const UsersRecordSchema = AuthRecordSchema.extend({
  name: z.string().max(100).optional(),
  avatar: z.string().optional(),
})

export const UsersCreateSchema = z.object({
  password: z.string().min(8),
  email: z.string().email(),
  emailVisibility: z.boolean().optional(),
  verified: z.boolean().optional(),
  name: z.string().max(100).optional(),
  avatar: z.string().optional(),
})

export const UsersUpdateSchema = UsersCreateSchema.partial()

// --- Categories ---

export const CategoriesRecordSchema = BaseRecordSchema.extend({
  name: z.string().min(1).max(100),
  slug: z.string().regex(/^[a-z0-9][a-z0-9-]*$/),
})

export const CategoriesCreateSchema = z.object({
  name: z.string().min(1).max(100),
  slug: z.string().regex(/^[a-z0-9][a-z0-9-]*$/),
})

export const CategoriesUpdateSchema = CategoriesCreateSchema.partial()

// --- Articles ---

export const ArticlesRecordSchema = BaseRecordSchema.extend({
  title: z.string().min(1).max(200),
  content: z.string().optional(),
  status: z.enum(["draft", "published", "archived"]),
  tags: z.array(z.enum(["technology", "design", "business", "lifestyle", "programming"])).max(5).optional(),
  author: z.string(),
  categories: z.array(z.string()).optional(),
  cover: z.string().optional(),
  views: z.number().min(0).int().optional(),
  featured: z.boolean().optional(),
  metadata: z.unknown().optional(),
  published_at: z.string().datetime({ offset: true }).optional(),
  source: z.string().url().optional(),
})

export const ArticlesCreateSchema = z.object({
  title: z.string().min(1).max(200),
  content: z.string().optional(),
  status: z.enum(["draft", "published", "archived"]),
  tags: z.array(z.enum(["technology", "design", "business", "lifestyle", "programming"])).max(5).optional(),
  author: z.string(),
  categories: z.array(z.string()).optional(),
  cover: z.string().optional(),
  views: z.number().min(0).int().optional(),
  featured: z.boolean().optional(),
  metadata: z.unknown().optional(),
  published_at: z.string().datetime({ offset: true }).optional(),
  source: z.string().url().optional(),
})

export const ArticlesUpdateSchema = ArticlesCreateSchema.partial()

// --- Comments ---

export const CommentsRecordSchema = BaseRecordSchema.extend({
  content: z.string().min(1).max(1000),
  article: z.string(),
  author: z.string(),
})

export const CommentsCreateSchema = z.object({
  content: z.string().min(1).max(1000),
  article: z.string(),
  author: z.string(),
})

export const CommentsUpdateSchema = CommentsCreateSchema.partial()
"
`;
